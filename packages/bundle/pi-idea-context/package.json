{
  "name": "@deepseek-ai/dsh-pi-idea-context",
  "description": "Pi-Idea selective research-context patch layer for DeepSeek Harness profiles",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/pi-idea-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "cordis.patch.yml", "skills/**", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/dsh-compaction-research-context": "workspace:^",
    "@deepseek-ai/dsh-goal-round-step-budget": "workspace:^",
    "@deepseek-ai/dsh-model-execution-policy": "workspace:^",
    "@deepseek-ai/dsh-research-authority-workspace": "workspace:^",
    "@deepseek-ai/dsh-research-context": "workspace:^",
    "@deepseek-ai/dsh-research-context-controls": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-client-ui-research-context": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  }
}
